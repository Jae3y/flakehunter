      "patch": {
        "root_cause_class": "race_condition",
        "root_cause_explanation": " background thread while the client makes a single connection attempt with a tight 5ms timeout. Under high worker oversubscription, thread preemption delays the service's response past the socket timeout, causing single-attempt fetches to fail. Retrying on transient OSError in StatusClient handles scheduling jitter and ensures reliable completion.",
        "confidence": "high",
        "files": [
          {
            "path": "app/client.py",
            "new_content": "\"\"\"Client for the internal status service.\"\"\"\n\nfrom __future__ import annotations\n\nimport socket\n\n#: How long to wait for the service before giving up.\nTIMEOUT_S = 0.005\nMAX_RETRIES = 20\n\n\nclass StatusClient:\n    \"\"\"Fetches a status line from the service over TCP.\"\"\"\n\n    def __init__(\n        self,\n        host: str,\n        port: int,\n        timeout_s: float = TIMEOUT_S,\n        max_retries: int = MAX_RETRIES,\n    ) -> None:\n        self.host = host\n        self.port = port\n        self.timeout_s = timeout_s\n        self.max_retries = max_retries\n\n    def fetch_status(self) -> bytes:\n        \"\"\"Return the service's status line.\n\n        Raises:\n            OSError: On connect failure or timeout after retries.\n        \"\"\"\n        last_exc: OSError | None = None\n        for _ in range(self.max_retries + 1):\n            try:\n                sock = socket.create_connection(\n                    (self.host, self.port), timeout=self.timeout_s\n                )\n                try:\n                    sock.settimeout(self.timeout_s)\n                    sock.sendall(b\"STATUS\\n\")\n                    return sock.recv(64)\n                finally:\n                    sock.close()\n            except OSError as exc:\n                last_exc = exc\n\n        if last_exc is not None:\n            raise last_exc\n        raise OSError(\"Failed to fetch status\")\n",
            "rationale": "Adds retry logic to StatusClient to handle transient socket timeouts and connection failures caused by background thread scheduling preemption under CPU load."
          }
        ]
      },
