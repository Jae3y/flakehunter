# Copy to .env and fill in. .env is gitignored and never committed.

# Required from Phase 2 onward (no LLM calls exist before then).
# Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Model used for BOTH baseline and agent. Both arms must use the same model
# or the comparison is not fair. Verify availability with scripts/check_llm.py.
FLAKEHUNTER_MODEL=gemini-3.6-flash

# Wall-clock ceiling for a single test execution, in seconds.
FLAKEHUNTER_RUN_TIMEOUT_S=15

# Address-space cap for a single test execution, in megabytes.
FLAKEHUNTER_RUN_MEMORY_MB=512
